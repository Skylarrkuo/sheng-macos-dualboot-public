+    try:
+        saved = json.loads(cache_record.read_text())
+        reused = saved == {'inputs': cache_inputs, 'sha256': library_digest()}
+    except (OSError, ValueError):
+        reused = False
+    if reused:
+        validate_library()
+        print('PASS: reused qualified Turnip library for ios27')
