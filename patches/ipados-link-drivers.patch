diff --git a/drivers/Adreno740/NativeAdrenoPublish.cpp b/drivers/Adreno740/NativeAdrenoPublish.cpp
--- a/drivers/Adreno740/NativeAdrenoPublish.cpp
+++ b/drivers/Adreno740/NativeAdrenoPublish.cpp
@@ -334,7 +334,9 @@
  * reports the pager's close (iokit_physical_descriptor_close_notify), the view's reference goes only then, when no map entry, memory
  * entry or copy refers to that VM object any more, and the pages return to the pool. Without that report the pool does not reuse
  * the pages of a grant that had a view unless the board set gpu-pool=2 (NativeAdrenoPool.h). */
+#if defined(XNU_TARGET_OS_OSX) && XNU_TARGET_OS_OSX
 extern "C" kern_return_t iokit_physical_descriptor_close_notify(IOMemoryDescriptor *,void (*)(void *),void *) __attribute__((weak_import));
+#endif
 class NativeAdrenoPoolView : public IOGeneralMemoryDescriptor {
     OSDeclareDefaultStructors(NativeAdrenoPoolView)
     NativeAdrenoPoolGrant *grant_=nullptr;
@@ -359,10 +361,14 @@
     IODeleteData(ranges,IOAddressRange,grant->count);
     if(view) {
         NativeAdrenoPoolRetain(grant);
+#if defined(XNU_TARGET_OS_OSX) && XNU_TARGET_OS_OSX
         /* Before anything can map the view: from here on the reference belongs to the kernel's report, which comes exactly once. */
         const bool hook=&iokit_physical_descriptor_close_notify!=nullptr;
         native_adreno_pool_views[4]=hook?1:0;
         view->tracked_=hook && iokit_physical_descriptor_close_notify(view,NativeAdrenoPoolViewClosed,grant)==KERN_SUCCESS;
+#else
+        native_adreno_pool_views[4]=0;
+#endif
         NativeAdrenoPoolNoteView(grant,view->tracked_);   /* a client can map the pages from here on */
         view->grant_=grant;
     }
diff --git a/drivers/RamBlock/NativeRamBlock.cpp b/drivers/RamBlock/NativeRamBlock.cpp
--- a/drivers/RamBlock/NativeRamBlock.cpp
+++ b/drivers/RamBlock/NativeRamBlock.cpp
@@ -23,9 +23,11 @@

 extern "C" {
 extern unsigned long gPhysBase, gPhysSize;
+#if defined(XNU_TARGET_OS_OSX) && XNU_TARGET_OS_OSX
 // The kernel's release of loader memory (payload-addon-release.patch); absent in a kernel without it.
 bool ml_static_mfree_prepare(vm_offset_t, vm_size_t) __attribute__((weak_import));
 void IODTFreeLoaderInfo(const char *, void *, int);
+#endif
 int native_ram_block_volume_device(const char *, dev_t *, char *, size_t);
 volatile uint32_t native_ram_block_ready = 0;
 volatile uint64_t native_ram_block_bytes = 0;
@@ -405,6 +407,7 @@
   }else SHA256_Update(&context, memory, bytes);
   SHA256_Final(seedHash, &context);
   }
+#if defined(XNU_TARGET_OS_OSX) && XNU_TARGET_OS_OSX
   // A packed seed was copied page by page into this disk's own memory and hashed from there: nothing reads the loader's
   // copy again. With boot-payload-release=1 its whole pages go back to the VM the way XNU returns loader memory, and the
   // range leaves the registry's /chosen/memory-map, so a second start finds no seed instead of freed memory.
@@ -414,6 +417,7 @@
     IODTFreeLoaderInfo("PackedRAMDisk", reinterpret_cast<void *>(physical), static_cast<int>(bytes));
     native_ram_block_seed_released = static_cast<uint32_t>(bytes >> 12);
   }
+#endif
   memcpy(native_ram_block_seed_sha256,seedHash,32);
   native_ram_block_bytes = logical;
   native_ram_block_sparse=(sparse.pages||isBig)?1:0;
